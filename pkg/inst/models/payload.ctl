NONMEM code for the final DXd model
;; Label:
;; [DXd]
$SUBROUTINE ADVAN13 TOL=6
$MODEL COMP=(CENTRAL) ; central
COMP=(PERI) ; peripheral
COMP=(CENTRALP) ; central payload
$PK
;;; V3SEXN-DEFINITION START
IF(SEXN.EQ.2) V3SEXN = (1+THETA(27))
IF(SEXN.EQ.1) V3SEXN = 1
;;; V3SEXN-DEFINITION END
;;; V3-RELATION START
V3COV=V3SEXN
;;; V3-RELATION END

;;; CLDXDTBILBL-DEFINITION START
CLDXDTBILBL = ((TBILBL/0.4)**THETA(26))
;;; CLDXDTBILBL-DEFINITION END
;;; CLDXDREGIONNL-DEFINITION START
IF(REGIONNL.EQ.2.0000E+00) CLDXDREGIONNL = 1 ; Most common
IF(REGIONNL.EQ.3.0000E+00) CLDXDREGIONNL = ( 1 + THETA(24))
IF(REGIONNL.EQ.1.0000E+00) CLDXDREGIONNL = 1
IF(REGIONNL.EQ.5.0000E+00) CLDXDREGIONNL = ( 1 + THETA(25))
;;; CLDXDREGIONNL-DEFINITION END
;;; CLDXDASTBL-DEFINITION START
CLDXDASTBL = ((ASTBL/22)**THETA(23))
;;; CLDXDASTBL-DEFINITION END
;;; CLDXDALBBL-DEFINITION START
IF(ALBBL.EQ.-99) THEN
CLDXDALBBL = 1
ELSE

CLDXDALBBL = ((ALBBL/38)**THETA(22))
ENDIF
;;; CLDXDALBBL-DEFINITION END
;;; CLDXD-RELATION START
CLDXDCOV=CLDXDALBBL*CLDXDASTBL*CLDXDREGIONNL*CLDXDTBILBL
;;; CLDXD-RELATION END
;;; V1SEXN-DEFINITION START
IF(SEXN.EQ.2) V1SEXN = (1+THETA(15))
IF(SEXN.EQ.1) V1SEXN = 1
;;; V1SEXN-DEFINITION END
;;; V1-RELATION START
V1COV=V1SEXN
;;; V1-RELATION END
;; VMTUMSBL-DEFINITION START
VMTUMSBL = ((TUMSBL/66)**THETA(14))

;;; VMTUMSBL-DEFINITION END
;;; CLSEXN-DEFINITION START
IF(SEXN.EQ.2) CLSEXN = (1+THETA(13))
IF(SEXN.EQ.1) CLSEXN = 1
;;; CLSEXN-DEFINITION END
;;; CLREGIONNL-DEFINITION START
IF(REGIONNL.NE.1.0000E+00) CLREGIONNL = 1 ; Most common
IF(REGIONNL.EQ.1.0000E+00) CLREGIONNL = ( 1 + THETA(12))
;;; CLREGIONNL-DEFINITION END
;;; CLALBBL-DEFINITION START
IF(ALBBL.EQ.-99) THEN
CLALBBL = 1
ELSE
CLALBBL = ((ALBBL/38)**THETA(11))
ENDIF
;;; CLALBBL-DEFINITION END

;;; CLAGEYBL-DEFINITION START
CLAGEYBL = ((AGEYBL/62)**THETA(10))
;;; CLAGEYBL-DEFINITION END
;;; CL-RELATION START
CLCOV=CLAGEYBL*CLALBBL*CLREGIONNL*CLSEXN
;;; CL-RELATION END
;;; VM-RELATION START
VMCOV=VMTUMSBL
;;; VM-RELATION END
TVCL = THETA(3) * (WTKGBL/66)**THETA(1)
TVCL = CLCOV*TVCL
TVV1 = THETA(4) * (WTKGBL/66)**THETA(2)
TVV1 = V1COV*TVV1

TVQ = THETA(5)

TVV2 = THETA(6) * (WTKGBL/66)**THETA(9)
TVVM = THETA(7)
TVVM = VMCOV*TVVM
TVKM = THETA(8)
CL = TVCL/24 * EXP(et2)
V1 = TVV1 * EXP(et3)
Q = TVQ/24 * EXP(et4)
V2 = TVV2 * EXP(et5)
VM = TVVM/24 * EXP(et6)
KM = TVKM * EXP(et7)
S1 = V1
; ======== Payload model ===============
PIR0 = 4 ;payload:intact ratio for converting intact clearance to payload release
MWI = 150000
MWP = 493.5
; Cycle 1 vs Cycle 2 and later

FCTN1 = 1 ;Cycle 1
IF (ACYCLN.GT.1) FCTN1 = THETA(18)
FCT1=FCTN1* EXP(ETA(4))
; time-dependent decline in each cycle, and the pattern held constant across cycles
ALPHA = 0.25
BETA= THETA(19)* EXP(ETA(5))
FCT2=ALPHA + (1-ALPHA)*EXP(-BETA*TSLDH)
PIR = PIR0 * FCT1 * FCT2
TVCLDXD = THETA(16)* (WTKGBL/66)**THETA(20)
TVCLDXD = CLDXDCOV*TVCLDXD
CLDXD = TVCLDXD * EXP(ETA(2))
TVV3 = THETA(17)* (WTKGBL/66)**THETA(21) ;L
TVV3 = V3COV*TVV3
V3 = TVV3* EXP(ETA(3))

S3 = V3
$DES
C1 = A(1)/V1
C2 = A(2)/V2
C3 = A(3)/V3
DADT(1) = - Q*C1 + Q*C2 - CL*C1 - VM*C1/(KM+C1)
DADT(2) = Q*C1 - Q*C2
DADT(3) = CL*C1*PIR*(MWP/MWI) + (VM*C1/(KM+C1))*PIR*(MWP/MWI) - CLDXD*C3
$ERROR
IF (TYPE.EQ.1) THEN
CP = A(1) / V1
IPRED = LOG(CP + 0.00001)
Y = IPRED + EPS(1) * EXP(et1)
ENDIF

IF (TYPE.EQ.2) THEN
CPP = A(3) / V3
IPRED = LOG(CPP + 0.00001)
Y = IPRED + EPS(2) * EXP(ETA(1))
ENDIF
$ESTIMATION METHOD=1 INTER ETASTYPE=1 MAXEVAL=9999 PRINT=1 NSIG=2
SIGL=6
$COVARIANCE PRINT=E MATRIX=R UNCONDITIONAL
