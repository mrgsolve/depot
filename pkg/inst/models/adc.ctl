NONMEM code for the final Dato-DXd model
;; Label:
;; [Dato-DXd]
$SUBROUTINE ADVAN13 TOL=6
$MODEL COMP=(CENTRAL) ; central
COMP=(PERI) ; peripheral
$PK
;;; V1SEXN-DEFINITION START
IF(SEXN.EQ.2) V1SEXN = (1+THETA(15))
IF(SEXN.EQ.1) V1SEXN = 1
;;; V1SEXN-DEFINITION END
;;; V1-RELATION START
V1COV=V1SEXN
;;; V1-RELATION END
;;; VMTUMSBL-DEFINITION START
VMTUMSBL = ((TUMSBL/66)**THETA(14))

;;; VMTUMSBL-DEFINITION END
;;; CLSEXN-DEFINITION START
IF(SEXN.EQ.2) CLSEXN = (1+THETA(13))
IF(SEXN.EQ.1) CLSEXN = 1
;;; CLSEXN-DEFINITION END
;;; CLREGIONNL-DEFINITION START
IF(REGIONNL.NE.1.0000E+00) CLREGIONNL = 1 ; Most common
IF(REGIONNL.EQ.1.0000E+00) CLREGIONNL = ( 1 + THETA(12))
;;; CLREGIONNL-DEFINITION END
;;; CLALBBL-DEFINITION START
IF(ALBBL.EQ.-99) THEN
CLALBBL = 1
ELSE
CLALBBL = ((ALBBL/38)**THETA(11))
ENDIF
;;; CLALBBL-DEFINITION END

;;; CLAGEYBL-DEFINITION START
CLAGEYBL = ((AGEYBL/62)**THETA(10))
;;; CLAGEYBL-DEFINITION END
;;; CL-RELATION START
CLCOV=CLAGEYBL*CLALBBL*CLREGIONNL*CLSEXN
;;; CL-RELATION END
;;; VM-RELATION START
VMCOV=VMTUMSBL
;;; VM-RELATION END
TVCL = THETA(3) * (WTKGBL/66)**THETA(1)
TVCL = CLCOV*TVCL
TVV1 = THETA(4) * (WTKGBL/66)**THETA(2)

TVV1 = V1COV*TVV1
TVQ = THETA(5)
TVV2 = THETA(6) * (WTKGBL/66)**THETA(9)
TVVM = THETA(7)
TVVM = VMCOV*TVVM
TVKM = THETA(8)
CL = TVCL/24 * EXP(ETA(2))
V1 = TVV1 * EXP(ETA(3))
Q = TVQ/24 * EXP(ETA(4))
V2 = TVV2 * EXP(ETA(5))
VM = TVVM/24 * EXP(ETA(6))
KM = TVKM * EXP(ETA(7))
S1 = V1
$DES
C1 = A(1)/V1
C2 = A(2)/V2

DADT(1) = - Q*C1 + Q*C2 - CL*C1 - VM*C1/(KM+C1)
DADT(2) = Q*C1 - Q*C2
$ERROR
CP = A(1) / V1
IPRED = LOG(CP + 0.00001)
Y = IPRED + EPS(1) * EXP(ETA(1))
$ESTIMATION METHOD=1 INTER ETASTYPE=1 MAXEVAL=9999 PRINT=1 NSIG=2
SIGL=6
$COVARIANCE PRINT=E MATRIX=S UNCONDITIONAL
